<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer on Android 12 and newer (AND-056): the audio files stay out, library.json, phone-index.json and library.json.good go in with the rest of filesDir. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="audio" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="audio" />
    </device-transfer>
</data-extraction-rules>
