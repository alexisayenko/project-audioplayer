{
  "fields": [
    {
      "id": "mainArtists",
      "path": "mainArtists",
      "label": "Main artist",
      "tone": "main",
      "description": "Who the song is by. For a cover this is the performer; for a mashup, whoever made it. A remix keeps the original artist here."
    },
    {
      "id": "title",
      "path": "title",
      "label": "Title",
      "tone": "title",
      "description": "The base title only, with no version text in it."
    },
    {
      "id": "featuredArtists",
      "path": "featuredArtists",
      "label": "Featured artist",
      "tone": "featured",
      "description": "Guests credited with \"feat.\" or \"ft.\" on the original release."
    },
    {
      "id": "version.type",
      "path": "version.type",
      "label": "Version type",
      "tone": "version",
      "description": "What kind of version this is: remix, cover, mashup, live, acoustic, extended, instrumental, remaster, edit or other."
    },
    {
      "id": "version.name",
      "path": "version.name",
      "label": "Version name",
      "tone": "version",
      "description": "The credited version text exactly as written, without the brackets."
    },
    {
      "id": "version.artists",
      "path": "version.artists",
      "label": "Version artist",
      "tone": "version",
      "description": "Extra people credited only on this version, such as a remixer. Empty for covers and mashups."
    },
    {
      "id": "version.originalArtists",
      "path": "version.originalArtists",
      "label": "Original artist",
      "tone": "original",
      "description": "Whose song it was before: one name for a cover, the sources for a mashup. Left out for every other type."
    },
    {
      "id": "version.releaseYear",
      "path": "version.releaseYear",
      "label": "Remix year",
      "tone": "version",
      "description": "The year of the version itself, such as the year of a remaster."
    },
    {
      "id": "releaseYear",
      "path": "releaseYear",
      "label": "Release year",
      "tone": "plain",
      "description": "The year of the original recording, taken from Wikipedia, MusicBrainz or Discogs, never from an upload date. It is not in the title."
    },
    {
      "id": "albums",
      "path": "albums",
      "label": "Albums",
      "tone": "plain",
      "description": "Albums the song appeared on; the first is the original one when known."
    },
    {
      "id": "genres",
      "path": "genres",
      "label": "Genres",
      "tone": "plain",
      "description": "Genre names, stored bare (house, soul), with no genre: prefix."
    },
    {
      "id": "sources",
      "path": "sources",
      "label": "Sources",
      "tone": "plain",
      "description": "Where the catalog entry points: a platform and a link, for example YouTube."
    },
    {
      "id": "audio",
      "path": "audio",
      "label": "Audio",
      "tone": "plain",
      "description": "Whether the audio file is on the server or the phone, and facts like the BPM."
    },
    {
      "id": "rawTitle",
      "path": "rawTitle",
      "label": "Raw title",
      "tone": "plain",
      "description": "The source title exactly as found, never edited. Everything above is read from it."
    }
  ],
