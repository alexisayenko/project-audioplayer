[
  {
    "name": "a continuous listen is one play",
    "ops": [{"op": "start", "id": "a"}, {"op": "advance", "to": 20, "step": 0.5}, {"op": "end"}],
    "plays": [{"song_id": "a", "listened_s": 20}]
  },
  {
    "name": "under five seconds is dropped",
    "ops": [{"op": "start", "id": "a"}, {"op": "advance", "to": 4, "step": 0.5}, {"op": "end"}],
    "plays": []
  },
  {
    "name": "exactly five seconds counts",
    "ops": [{"op": "start", "id": "a"}, {"op": "advance", "to": 5, "step": 0.5}, {"op": "end"}],
    "plays": [{"song_id": "a", "listened_s": 5}]
  },
  {
    "name": "a seek adds nothing",
    "ops": [
      {"op": "start", "id": "a"}, {"op": "advance", "to": 10, "step": 0.5},
      {"op": "seek", "to": 200}, {"op": "advance", "to": 204, "step": 0.5}, {"op": "end"}
    ],
    "plays": [{"song_id": "a", "listened_s": 14}]
  },
  {
    "name": "a jump larger than one step adds nothing",
    "ops": [
      {"op": "start", "id": "a"}, {"op": "advance", "to": 6, "step": 0.5},
      {"op": "tick", "to": 30}, {"op": "advance", "to": 33, "step": 0.5}, {"op": "end"}
    ],
    "plays": [{"song_id": "a", "listened_s": 9}]
  },
  {
    "name": "a step backwards adds nothing",
    "ops": [
      {"op": "start", "id": "a"}, {"op": "advance", "to": 6, "step": 0.5},
      {"op": "tick", "to": 3}, {"op": "advance", "to": 6, "step": 0.5}, {"op": "end"}
    ],
    "plays": [{"song_id": "a", "listened_s": 9}]
  },
  {
    "name": "a pause does not end the play",
    "ops": [
      {"op": "start", "id": "a"}, {"op": "advance", "to": 6, "step": 0.5}, {"op": "pause"},
      {"op": "resume"}, {"op": "advance", "to": 12, "step": 0.5}, {"op": "end"}
    ],
    "plays": [{"song_id": "a", "listened_s": 12}]
  },
  {
    "name": "a song change ends the play",
    "ops": [
      {"op": "start", "id": "a"}, {"op": "advance", "to": 6, "step": 0.5},
      {"op": "song", "id": "b"}, {"op": "advance", "to": 8, "step": 0.5}, {"op": "end"}
    ],
    "plays": [{"song_id": "a", "listened_s": 6}, {"song_id": "b", "listened_s": 8}]
  },
  {
    "name": "a short song before a change is dropped",
    "ops": [
      {"op": "start", "id": "a"}, {"op": "advance", "to": 3, "step": 0.5},
      {"op": "song", "id": "b"}, {"op": "advance", "to": 7, "step": 0.5}, {"op": "end"}
    ],
    "plays": [{"song_id": "b", "listened_s": 7}]
  },
  {
    "name": "the same song played twice is two plays",
    "ops": [
      {"op": "start", "id": "a"}, {"op": "advance", "to": 6, "step": 0.5}, {"op": "end"},
      {"op": "start", "id": "a"}, {"op": "advance", "to": 7, "step": 0.5}, {"op": "end"}
    ],
    "plays": [{"song_id": "a", "listened_s": 6}, {"song_id": "a", "listened_s": 7}]
  }
]
