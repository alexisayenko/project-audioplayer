# Copy to .env (git-ignored). Generate with: openssl rand -hex 32
AUDIO_API_TOKEN=change-me

# Plain-file mode (dev/tests): used when AUDIO_DATA_REPO is unset.
# users/<uid>/{profile,library}.json and users/<uid>/covers/ live here (ADR-0012).
AUDIO_DATA_DIR=.
# Audio dir when no music root is configured; each user's audio is in <root>/users/<uid>/.
AUDIO_DOWNLOAD_DIR=downloads

# Audio location. Normally settings.music_root in library.json; this overrides it.
# Form: <servername>://<path>/ or a plain local path.
# AUDIO_MUSIC_ROOT=perkunas://data/music/
# <servername> -> local mount path (never put IPs/credentials in library.json):
# AUDIO_HOSTS=perkunas=/data/music-mount;other=/mnt/x
# or a JSON file outside the repo: {"perkunas": "/data/music-mount"}
# AUDIO_HOSTS_FILE=/etc/audioplayer/hosts.json

# Git-backed store (ADR-0005): local clones, writer commits and pushes.
# AUDIO_DATA_REPO=/srv/audioplayer/data-storage        # files: audioplayer/users/<uid>/{profile,library}.json
# AUDIO_COVERS_REPO=/srv/audioplayer/data-storage-lfs  # files: audioplayer/users/<uid>/covers/<id>.jpg
# Deploy key (chmod 600, outside the repos); sets GIT_SSH_COMMAND. Never logged.
# AUDIO_GIT_SSH_KEY=/home/audio/.config/audioplayer/deploy_key

# Static UI directory (default: <repo>/web).
# AUDIO_WEB_DIR=../web

# MusicBrainz/Wikidata/Wikipedia suggestions (tags, year, links) in /preview and /lookup/wikipedia. Default on;
# 0/false/no/off disables (AUDIO_GENRE_LOOKUP is the older alias, either one off disables).
# AUDIO_TAG_LOOKUP=1
# AUDIO_GENRE_LOOKUP=1
# AUDIO_MB_USER_AGENT=audioplayer/0.1 (you@example.com)   # sent to musicbrainz.org, wikidata.org, wikipedia.org

# OAuth sign-in (ADR-0006, ADR-0012). Authorization: Bearer <ID token>; X-API-Token is the owner's credential.
# Any verified Google/Apple identity may sign in and gets its own library (open signup).
# The owner (exempt from per-user quotas, owner of the migrated legacy library). ALLOWED_EMAIL is a deprecated alias.
# OWNER_EMAIL=alex.isayenko@gmail.com
# 0 = only existing users and the owner can sign in.
# SIGNUP_OPEN=1
# Apple hides/relays email after first login: pin the stable Apple user id (sub) of the owner once known.
# ALLOWED_APPLE_SUB=
# Accepted ID-token audiences, comma-separated: iOS plus web.
# APPLE_AUDIENCE=com.alexisayenko.audioplayer,<apple-services-id>   # app bundle id, web Services ID
# GOOGLE_CLIENT_ID=<ios-client-id>.apps.googleusercontent.com,<web-client-id>.apps.googleusercontent.com

# Web UI sign-in (ADR-0006 amendment). Non-secret ids, published by GET /auth/config;
# they are accepted as audiences too, so listing them above as well is optional.
# GOOGLE_WEB_CLIENT_ID=<web-client-id>.apps.googleusercontent.com
# APPLE_WEB_CLIENT_ID=<apple-services-id>
# APPLE_WEB_REDIRECT_URI=https://play.example.com/   # default: https://<Host>/
# Signs the 12 h session cookie. Secret: openssl rand -hex 32. Unset: derived from AUDIO_API_TOKEN.
# AUDIO_SESSION_SECRET=change-me

# Limits per user (the owner is exempt) and for the whole server (ADR-0012).
# USER_MAX_SONGS=500
# USER_MAX_BYTES=5368709120            # 5 GB of audio
# USER_ADDS_PER_HOUR=20
# USER_MAX_CONCURRENT_DOWNLOADS=1      # extra adds wait with status "queued"
# GLOBAL_MAX_CONCURRENT_DOWNLOADS=2
# POOL_MAX_BYTES=161061273600          # 150 GB under <music_root>/users; refuses new downloads, owner included
