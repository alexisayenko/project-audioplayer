# Copy to .env (git-ignored). Generate with: openssl rand -hex 32
AUDIO_API_TOKEN=change-me

# Plain-file mode (dev/tests): used when AUDIO_DATA_REPO is unset.
# library.json and covers/ live here.
AUDIO_DATA_DIR=.
# Audio dir when settings.music_root is not set (migration default).
AUDIO_DOWNLOAD_DIR=downloads

# Audio location. Normally settings.music_root in library.json; this overrides it.
# Form: <servername>://<path>/ or a plain local path.
# AUDIO_MUSIC_ROOT=perkunas://data/music/
# <servername> -> local mount path (never put IPs/credentials in library.json):
# AUDIO_HOSTS=perkunas=/data/music-mount;other=/mnt/x
# or a JSON file outside the repo: {"perkunas": "/data/music-mount"}
# AUDIO_HOSTS_FILE=/etc/audioplayer/hosts.json

# Git-backed store (ADR-0005): local clones, writer commits and pushes.
# AUDIO_DATA_REPO=/srv/audioplayer/data-storage        # file: audioplayer/library.json
# AUDIO_COVERS_REPO=/srv/audioplayer/data-storage-lfs  # files: audioplayer/covers/<id>.jpg
# Deploy key (chmod 600, outside the repos); sets GIT_SSH_COMMAND. Never logged.
# AUDIO_GIT_SSH_KEY=/home/audio/.config/audioplayer/deploy_key

# Static UI directory (default: <repo>/web).
# AUDIO_WEB_DIR=../web

# MusicBrainz/Wikidata/Wikipedia suggestions (tags, year, links) in /preview and /lookup/wikipedia. Default on;
# 0/false/no/off disables (AUDIO_GENRE_LOOKUP is the older alias, either one off disables).
# AUDIO_TAG_LOOKUP=1
# AUDIO_GENRE_LOOKUP=1
# AUDIO_MB_USER_AGENT=audioplayer/0.1 (you@example.com)   # sent to musicbrainz.org, wikidata.org, wikipedia.org

# Owner-only OAuth sign-in (ADR-0006). Authorization: Bearer <ID token>; X-API-Token keeps working.
# Only this verified email may sign in (default shown; not a secret).
# ALLOWED_EMAIL=alex.isayenko@gmail.com
# Apple hides/relays email after first login: pin the stable Apple user id (sub) once known.
# ALLOWED_APPLE_SUB=
# APPLE_AUDIENCE=com.alexisayenko.audioplayer   # app bundle id (Apple ID token aud)
# GOOGLE_CLIENT_ID=<ios-client-id>.apps.googleusercontent.com   # Google OAuth iOS client id
